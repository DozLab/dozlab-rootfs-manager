#!/bin/sh
# First boot of a k8s lab VM: set up a single-node Kubernetes cluster with kubeadm, so the
# student gets a working cluster. Runs once (the systemd unit skips it once admin.conf exists,
# so a persistent session keeps its cluster).
set -eu

ip=$(ip -4 -o addr show eth0 | awk '{print $4}' | cut -d/ -f1)
version=$(kubeadm version -o short)   # the installed version; don't ask dl.k8s.io for "stable"

kubeadm init \
    --kubernetes-version "$version" \
    --apiserver-advertise-address "$ip" \
    --pod-network-cidr 10.244.0.0/16 \
    --node-name "$(hostname)"

mkdir -p /root/.kube
cp /etc/kubernetes/admin.conf /root/.kube/config

# Single node: let pods run on the control plane
kubectl --kubeconfig /etc/kubernetes/admin.conf taint nodes --all node-role.kubernetes.io/control-plane-
